NODE_ENV=development
PORT=4000
MONGO_URI=mongodb+srv://USER:PASSWORD@TEST_CLUSTER/leanfit_test
JWT_ACCESS_SECRET=replace-with-a-local-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-local-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_BOOTSTRAP_KEY=replace-with-a-local-random-secret
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
LOCAL_UPLOADS=true
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace-with-test-secret
APPOINTMENT_FEE_PAISE=50000
CF_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
JITSI_BASE_URL=https://jitsi.riot.im
NOTIFICATIONS_ENABLED=false
NOTIFICATION_WORKER_ENABLED=true
# If PM2 uses a custom instance_var, put that variable name here.
NOTIFICATION_WORKER_INSTANCE_VAR=NODE_APP_INSTANCE
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_MESSAGE_DOMAIN=lean-fit.in
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_OTP_TEMPLATE=leanfit_verification_code
WHATSAPP_TEMPLATE_BOOKINGCONFIRMATION=leanfit_booking_confirmation
WHATSAPP_TEMPLATE_BOOKINGREMINDER=leanfit_booking_reminder
WHATSAPP_TEMPLATE_SUBSCRIPTIONEXPIRY=leanfit_subscription_expiry
WHATSAPP_TEMPLATE_MEALUPLOAD=leanfit_meal_upload
# Required for production uploads only; development uses .local-uploads/.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_BASE_URL=

# Public website URL used for notification meeting links.
FRONTEND_URL=http://localhost:3000
